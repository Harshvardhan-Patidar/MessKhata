# MessKhata Backend Test Environment
# Copy this to .env.test and fill in real values
# Never commit this file to git

# Core Supabase (required for all tests)
VITE_SUPABASE_URL=https://imsdsuyzjffmidswpzdr.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_ACTUAL_ANON_KEY_NOT_SERVICE_ROLE>

# Admin test account (for TC08-TC14, TC16)
# Get these from a real admin login session
TEST_ADMIN_ACCESS_TOKEN=
TEST_ADMIN_REFRESH_TOKEN=

# Second admin for cross-tenant RLS tests (TC11)
TEST_ADMIN_B_ACCESS_TOKEN=
TEST_ADMIN_B_REFRESH_TOKEN=
TEST_ADMIN_B_CUSTOMER_ID=    # UUID of a customer belonging to Admin B

# Admin credentials for testing TC01 / TC05
TEST_ADMIN_NAME=Harsh
TEST_ADMIN_PHONE=9999999999

# Student test account (for TC05-TC07)
TEST_STUDENT_NAME=Ravi Kumar
TEST_STUDENT_MOBILE=9876543210
TEST_STUDENT_CODE=CUST-001
TEST_CUSTOMER_ID=             # UUID of the test student customer row

# For IDOR test (TC07)
TEST_OTHER_CUSTOMER_ID=       # UUID of a DIFFERENT student's customer row
